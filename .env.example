# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Elasticsearch endpoint. Use the server hostname (matching its certificate),
# not the IP, e.g. https://siem-server:9200
ES_URL=https://siem-server:9200

# Read-only API key (Encoded/base64 form), scoped to the alert and log indices.
# Create it in Kibana: Stack Management > Security > API keys.
ES_API_KEY=your_base64_encoded_api_key_here

# Absolute path to the Elasticsearch CA certificate copied to this machine.
ES_CA_CERT=/home/orchestrator/detection-validator/http_ca.crt
